.data
    msg1: .asciiz "\nDigite um numero (negativo encerra): "
    msg2: .asciiz "\nNumero invalido! Digite de 0 a 100."
    msg3: .asciiz "\nQuantidade de 0 a 25: "
    msg4: .asciiz "\nQuantidade de 26 a 50: "
    msg5: .asciiz "\nQuantidade de 51 a 75: "
    msg6: .asciiz "\nQuantidade de 76 a 100: "

.text
.globl main

main:
    li $t1, 0
    li $t2, 0
    li $t3, 0
    li $t4, 0

ler:
    li $v0, 4
    la $a0, msg1
    syscall

    li $v0, 5
    syscall
    move $t0, $v0

    bltz $t0, mostrar

    li $t5, 100
    bgt $t0, $t5, invalido

    li $t5, 25
    ble $t0, $t5, intervalo1

    li $t5, 50
    ble $t0, $t5, intervalo2

    li $t5, 75
    ble $t0, $t5, intervalo3

    addi $t4, $t4, 1
    j ler

intervalo1:
    addi $t1, $t1, 1
    j ler

intervalo2:
    addi $t2, $t2, 1
    j ler

intervalo3:
    addi $t3, $t3, 1
    j ler

invalido:
    li $v0, 4
    la $a0, msg2
    syscall
    j ler

mostrar:

    li $v0, 4
    la $a0, msg3
    syscall

    li $v0, 1
    move $a0, $t1
    syscall

    li $v0, 4
    la $a0, msg4
    syscall

    li $v0, 1
    move $a0, $t2
    syscall

    li $v0, 4
    la $a0, msg5
    syscall

    li $v0, 1
    move $a0, $t3
    syscall

    li $v0, 4
    la $a0, msg6
    syscall

    li $v0, 1
    move $a0, $t4
    syscall

    li $v0, 10
    syscall
